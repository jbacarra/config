this has a bunch of config stuff for mac
create a hard symlink: ln link_test /tmp/link_new


run these commands:
xcode-select --install
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
brew doctor

cd ~/config

mkdir -p ~/.ssh
FILE="~/.ssh/config"
touch "$FILE"
if [ -s "$FILE" ]; then
    cat ./sshconfig >> "$FILE"
else
    rm "$FILE"
    ln sshconfig "$FILE"
fi

FILE="~/.zshrc"
touch "$FILE"
if [ -s "$FILE" ]; then
    cat ./zshrc:hard >> "$FILE"
else
    rm "$FILE"
    ln zshrc:hard "$FILE"
fi

FILE=" ~/.gitconfig"
touch "$FILE"
if [ -s "$FILE" ]; then
    cat ./gitconfig:hard >> "$FILE"
else
    rm "$FILE"
    ln gitconfig:hard "$FILE"
fi
